<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>OpenCV reference algorithms (SIFT, ORB, AKAZE) exposed through Salient's feature contracts.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" />
    <!-- Native OpenCV for the build platform only; the Docker image and CI need just the Linux runtime. -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64.slim" Condition="'$(OS)' != 'Windows_NT'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Salient.Core\Salient.Core.csproj" />
    <ProjectReference Include="..\Salient.Features\Salient.Features.csproj" />
  </ItemGroup>

</Project>
