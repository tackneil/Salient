<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>Salient web host: REST API, SignalR hub, job queue, storage and SPA hosting.</Description>
    <!-- Build-time OpenAPI document for the generated TypeScript client (ADR-0010). -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../web/openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Salient.Core\Salient.Core.csproj" />
    <ProjectReference Include="..\Salient.Features\Salient.Features.csproj" />
    <ProjectReference Include="..\Salient.Features.Sift\Salient.Features.Sift.csproj" />
    <ProjectReference Include="..\Salient.Matching\Salient.Matching.csproj" />
    <ProjectReference Include="..\Salient.Evaluation\Salient.Evaluation.csproj" />
    <ProjectReference Include="..\Salient.Reference.OpenCv\Salient.Reference.OpenCv.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

</Project>
