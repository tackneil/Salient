  "components": {
    "schemas": {
      "AlgorithmInfo": {
        "required": [
          "id",
          "displayName",
          "family",
          "capabilities",
          "version",
          "parameterSchema"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "parameterSchema": {
            "$ref": "#/components/schemas/JsonObject"
          }
        }
      },
      "BenchmarkRequest": {
        "required": [
          "imageId",
          "algorithmIds",
          "families"
        ],
        "type": "object",
        "properties": {
          "imageId": {
            "type": "string"
          },
          "algorithmIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "families": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            }
          }
        }
      },
      "BenchmarkResultDto": {
        "required": [
          "families"
        ],
        "type": "object",
        "properties": {
          "families": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SweepResult"
            }
          }
        }
      },
      "CandidateDto": {
        "required": [
          "x",
          "y",
          "scale",
          "octave",
          "contrast",
          "edgeRatio",
          "rejection"
        ],
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "format": "float"
          },
          "y": {
            "type": "number",
            "format": "float"
          },
          "scale": {
            "type": "number",
            "format": "float"
          },
          "octave": {
            "type": "integer",
            "format": "int32"
          },
          "contrast": {
            "type": [
              "null",
              "number"
            ],
            "format": "float"
          },
          "edgeRatio": {
            "type": [
              "null",
              "number"
            ],
            "format": "float"
          },
          "rejection": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ComparisonRequest": {
        "required": [
          "imageId",
          "parameters"
        ],
        "type": "object",
        "properties": {
          "imageId": {
            "type": "string"
          },
          "parameters": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonElement"
              }
            ]
          }
        }
      },
      "ComparisonResultDto": {
        "required": [
          "salient",
          "reference",
          "salientMs",
          "referenceMs",
          "repeatability",
          "onlySalient",
          "onlyReference",
          "meanOffset"
        ],
        "type": "object",
        "properties": {
          "salient": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PointDto"
            }
          },
          "reference": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PointDto"
            }
          },
          "salientMs": {
            "type": "number",
            "format": "double"
          },
          "referenceMs": {
            "type": "number",
            "format": "double"
          },
          "repeatability": {
            "type": "number",
            "format": "double"
          },
          "onlySalient": {
            "type": "integer",
            "format": "int32"
          },
          "onlyReference": {
            "type": "integer",
            "format": "int32"
          },
          "meanOffset": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "DescriptorInfo": {
        "required": [
          "kind",
          "dimension"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/DescriptorKind"
          },
          "dimension": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "DescriptorKind": {
        "enum": [
          "real",
          "binary"
        ],
        "description": "How descriptor values are stored and compared."
      },
      "DetectionRequest": {
        "required": [
          "imageId",
          "algorithmId",
          "parameters"
        ],
        "type": "object",
        "properties": {
          "imageId": {
            "type": "string"
          },
          "algorithmId": {
            "type": "string"
          },
          "parameters": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonElement"
              }
            ]
          }
        }
      },
      "DetectionResultDto": {
        "required": [
          "width",
          "height",
          "parameters",
          "explorationParameters",
          "descriptor",
          "keypoints"
        ],
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "parameters": {
            "$ref": "#/components/schemas/JsonElement"
          },
          "explorationParameters": {
            "$ref": "#/components/schemas/JsonElement"
          },
          "descriptor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DescriptorInfo"
              }
            ]
          },
          "keypoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KeypointDto"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "ImageInfo": {
        "required": [
          "id",
          "width",
          "height",
          "originalWidth",
          "originalHeight",
          "fileName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "originalWidth": {
            "type": "integer",
            "format": "int32"
          },
          "originalHeight": {
            "type": "integer",
            "format": "int32"
          },
          "fileName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "JsonElement": { },
      "JsonObject": {
        "type": "object"
      },
      "KeypointDetail": {
        "required": [
          "index",
          "keypoint",
          "orientationHistogram",
          "descriptor",
          "binaryDescriptor"
        ],
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "keypoint": {
            "$ref": "#/components/schemas/KeypointDto"
          },
          "orientationHistogram": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "number",
              "format": "float"
            }
          },
          "descriptor": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "number",
              "format": "float"
            }
          },
          "binaryDescriptor": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "integer",
              "format": "uint8"
            }
          }
        }
      },
      "KeypointDto": {
        "required": [
          "x",
          "y",
          "scale",
          "angle",
          "response",
          "octave",
          "contrast",
          "edgeRatio"
        ],
        "type": "object",
        "properties": {
