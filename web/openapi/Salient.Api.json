          "correctMatches"
        ],
        "type": "object",
        "properties": {
          "repeatability": {
            "type": "number",
            "description": "Fraction of keypoints, among those visible in both images, that are re-detected: within the position tolerance after\r\nmapping and at a consistent scale. Divided by the smaller visible count, so it lies in [0, 1].",
            "format": "double"
          },
          "matchingScore": {
            "type": "number",
            "description": "Correct ratio-test matches divided by the reference keypoints visible in the transformed image.",
            "format": "double"
          },
          "matchPrecision": {
            "type": "number",
            "description": "Correct matches divided by all ratio-test matches; 0 when there are no matches.",
            "format": "double"
          },
          "referenceKeypoints": {
            "type": "integer",
            "description": "Keypoints in the reference image.",
            "format": "int32"
          },
          "transformedKeypoints": {
            "type": "integer",
            "description": "Keypoints in the transformed image.",
            "format": "int32"
          },
          "matches": {
            "type": "integer",
            "description": "Matches after the ratio test.",
            "format": "int32"
          },
          "correctMatches": {
            "type": "integer",
            "description": "Matches whose keypoints agree with the ground truth within the position tolerance.",
            "format": "int32"
          }
        },
        "description": "Measurements for one reference/transformed image pair."
